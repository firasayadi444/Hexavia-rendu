# Copier ce fichier en .env.local pour le développement, ou saisir ces variables chez l'hébergeur.
# Aucune n'est obligatoire : sans clé, les propositions de l'IA sont simulées.

# Clé du fournisseur de modèle. Lue uniquement côté serveur, jamais envoyée au navigateur.
# V1 : la clé est détectée, mais les propositions restent simulées (voir src/modules/ai/provider.ts).
AI_API_KEY=

# Nom du modèle à appeler le jour où un fournisseur est branché.
AI_MODEL=

# Priorités stratégiques du client, séparées par des virgules. Elles servent au critère « alignement ».
# Exemple : STRATEGIC_PRIORITIES=sécurité,énergie
STRATEGIC_PRIORITIES=

# Nom du client affiché dans l'interface et dans la shortlist.
NEXT_PUBLIC_CLIENT_NAME=Hexavia
